{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CLARA-Eval VN externally governed live execution manifest",
  "type": "object",
  "required": ["schema_version", "approval", "contains_phi", "contains_secrets", "records"],
  "properties": {
    "schema_version": {"const": "clara-eval-vn.live-execution-manifest.v1"},
    "approval": {
      "type": "object",
      "required": ["approved_for_live_execution", "reference"],
      "properties": {
        "approved_for_live_execution": {"const": true},
        "reference": {"type": "string", "minLength": 1, "maxLength": 200}
      },
      "additionalProperties": false
    },
    "contains_phi": {"const": false},
    "contains_secrets": {"const": false},
    "retrieval_snapshot": {
      "type": "object",
      "required": ["reference", "sha256"],
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "release_binding": {
      "type": "object",
      "required": ["locked_dataset_ref", "release_ref"],
      "properties": {
        "locked_dataset_ref": {"type": "string", "minLength": 1, "maxLength": 200},
        "release_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "required": ["case_id", "track_id", "endpoint", "path", "request", "scorer"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,79}$"},
          "track_id": {"type": "string"},
          "endpoint": {"enum": ["api", "ml"]},
          "path": {"type": "string", "pattern": "^/"},
          "request": {"type": "object"},
          "critical_error_type": {"type": "string", "maxLength": 100},
          "ablation_variant": {"enum": ["C0", "C1", "C2", "C3", "C4"]},
          "scorer": {
            "type": "object",
            "required": ["type", "metric_id", "json_path", "expected"],
            "properties": {
              "type": {"const": "json_path_equals"},
              "metric_id": {"type": "string"},
              "json_path": {"type": "string", "minLength": 1},
              "expected": {}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
