{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commitloop-prediction.v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["lifecycle_state", "evidence_state", "timeliness_state", "escalation_state", "confidence"],
  "properties": {
    "lifecycle_state": {
      "enum": ["OPEN", "PARTIALLY_SATISFIED", "SATISFIED", "SUPERSEDED", "CANCELLED"]
    },
    "evidence_state": {
      "enum": ["CLEAR", "CONFLICTED", "INSUFFICIENT_EVIDENCE"]
    },
    "timeliness_state": {
      "enum": ["NOT_APPLICABLE", "BEFORE_DUE", "IN_GRACE", "OVERDUE", "UNKNOWN"]
    },
    "escalation_state": {
      "enum": ["ESCALATE", "NO_ESCALATION"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Probability that all three product-state axes are jointly exact."
    }
  }
}
