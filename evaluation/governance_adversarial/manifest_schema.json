{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GovRed-Health frozen attack manifest",
  "type": "object",
  "required": ["schema_version", "status", "study_id", "manifest_id", "created_at", "code_revision", "seed", "statistics_plan_sha256", "primary_family_ids", "cases"],
  "properties": {
    "schema_version": {"const": "govred-attack-manifest-v1"},
    "status": {"enum": ["draft", "frozen"]},
    "study_id": {"const": "govred-rivf-2026"},
    "manifest_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "code_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "seed": {"type": "integer"},
    "statistics_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "primary_family_ids": {"const": ["cross_subject_retrieval", "cross_subject_proposal_write", "revoked_consent_cache_index_reuse", "role_mismatch", "purpose_mismatch", "stale_thss_replay", "concurrent_stale_state_write", "authorization_consent_toctou", "policy_version_change"]},
    "cases": {"type": "array", "minItems": 15, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["case_id", "family", "reporting_scope", "subject", "actor", "purpose", "initial_state", "schedule", "expected_invariant", "oracle", "arm_applicability"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "family": {"enum": ["cross_subject_retrieval", "cross_subject_proposal_write", "revoked_consent_cache_index_reuse", "role_mismatch", "purpose_mismatch", "stale_thss_replay", "concurrent_stale_state_write", "authorization_consent_toctou", "policy_version_change", "gst_bypass_prompt", "patient_evidence_prompt_injection", "unrelated_disclosure_request", "derived_cache_persistence_after_revocation", "digest_expiry_tamper_replay", "audit_reconstruction_failure"]},
        "reporting_scope": {"enum": ["primary_authorization_drift", "secondary_robustness_stress"]},
        "subject": {"type": "string", "pattern": "^synthetic-sentinel-"},
        "actor": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "initial_state": {"type": "object"},
        "schedule": {"type": "array", "minItems": 1},
        "expected_invariant": {"type": "string", "minLength": 1},
        "oracle": {"type": "object", "required": ["kind", "sentinel_token"]},
        "arm_applicability": {"type": "array", "minItems": 1, "items": {"enum": ["UNBOUND", "STATE_VERSION_ONLY", "SNAPSHOT_BOUND_STATE_ONLY", "GLHS_STRICT"]}}
      }
    }
  }
}
