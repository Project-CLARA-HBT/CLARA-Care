            "type": "string",
            "title": "Version",
            "description": "Control plane build release version",
            "default": "v2026.4.0"
          },
          "timestamp": {
            "type": "string",
            "title": "Timestamp"
          },
          "plane": {
            "type": "string",
            "title": "Plane",
            "default": "control-plane-isolated"
          },
          "details": {
