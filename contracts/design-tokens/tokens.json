{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "contract": "clara.design-tokens",
  "version": "2026-08-19.v1",
  "scope": "Platform-neutral semantic design tokens for CLARA web and mobile clients.",
  "tokens": {
    "color": {
      "surface": {
        "canvas": {
          "light": "#F6F8FC",
          "dark": "#101419",
          "description": "Page background canvas"
        },
        "base": {
          "light": "#FFFFFF",
          "dark": "#1D2025",
          "description": "Standard card and container surface"
        },
        "subtle": {
          "light": "#EEF3F8",
          "dark": "#272A30",
          "description": "Quiet section and secondary surface"
        },
        "raised": {
          "light": "#FFFFFF",
          "dark": "#272A30",
          "description": "Elevated card and side sheet surface"
        },
        "overlay": {
          "light": "#FFFFFF",
          "dark": "#1D2025",
          "description": "Modal and popover overlay surface"
        },
        "sidebar": {
          "light": "#0B0E13",
          "dark": "#0B0E13",
          "description": "Navigation and sidebar surface"
        },
        "header": {
          "light": "rgba(255, 255, 255, 0.92)",
          "dark": "rgba(16, 20, 25, 0.92)",
          "description": "Top bar and command bar header surface"
        },
        "brand_soft": {
          "light": "rgba(0, 83, 219, 0.08)",
          "dark": "rgba(164, 201, 255, 0.12)",
          "description": "Subtle brand tint for badges and highlights"
        }
      },
      "content": {
        "primary": {
          "light": "#172033",
          "dark": "#E1E2E9",
          "description": "Primary body and heading text"
        },
        "secondary": {
          "light": "#526277",
          "dark": "#C1C7D3",
          "description": "Secondary supporting text"
        },
        "muted": {
          "light": "#718096",
          "dark": "#8B919D",
          "description": "Captions and disabled guidance"
        },
        "brand": {
          "light": "#0053DB",
          "dark": "#A4C9FF",
          "description": "Brand accented text and highlights"
        },
        "inverse": {
          "light": "#FFFFFF",
          "dark": "#CDD7FF",
          "description": "Text on primary action surfaces"
        },
        "link": {
          "light": "#0053DB",
          "dark": "#A4C9FF",
          "description": "Interactive text links"
        }
      },
      "border": {
        "subtle": {
          "light": "#D8E2EC",
          "dark": "#414751",
          "description": "Non-interactive dividers and panel boundaries"
        },
        "control": {
          "light": "#CBD5E1",
          "dark": "#414751",
          "description": "Input and interactive control boundary"
        },
        "strong": {
          "light": "#94A3B8",
          "dark": "#8B919D",
          "description": "Selected or high-emphasis boundary"
        }
      },
      "action": {
        "primary": {
          "light": "#0053DB",
          "dark": "#0053DB",
          "description": "Primary action button background"
        },
        "primary_hover": {
          "light": "#003EA8",
          "dark": "#003EA8",
          "description": "Primary action button hover state"
        },
        "primary_active": {
          "light": "#002A78",
          "dark": "#002A78",
          "description": "Primary action button active state"
        },
        "primary_text": {
          "light": "#FFFFFF",
          "dark": "#CDD7FF",
          "description": "Primary action button text"
        },
        "secondary_bg": {
          "light": "#FFFFFF",
          "dark": "#1D2025",
          "description": "Secondary action button background"
        },
        "secondary_border": {
          "light": "#D8E2EC",
          "dark": "#414751",
          "description": "Secondary action button border"
        },
        "secondary_text": {
          "light": "#172033",
          "dark": "#E1E2E9",
          "description": "Secondary action button text"
        },
        "danger_bg": {
          "light": "#DC2626",
          "dark": "#93000A",
          "description": "Destructive action button background"
        },
        "danger_text": {
          "light": "#FFFFFF",
          "dark": "#FFDAD6",
          "description": "Destructive action button text"
        }
      },
      "focus": {
        "color": {
          "light": "#0053DB",
          "dark": "#A4C9FF",
          "description": "Focus ring indicator color"
        },
        "width": "2px",
        "offset": "2px"
      }
    },
    "space": {
      "0": "0px",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "8": "32px",
      "10": "40px",
      "12": "48px",
      "16": "64px",
      "touch_target_min": "44px",
      "gutter": "1rem",
      "gutter_lg": "1.5rem",
      "gutter_2xl": "3rem"
    },
    "radius": {
      "none": "0px",
      "sm": "4px",
      "md": "8px",
      "lg": "12px",
      "xl": "14px",
      "2xl": "24px",
      "pill": "9999px",
      "control": "8px",
      "card": "14px",
      "panel": "18px"
    },
    "typography": {
      "font_family": {
        "sans": "Be Vietnam Pro, Segoe UI Variable, Segoe UI, ui-sans-serif, system-ui, -apple-system, Helvetica, Arial, sans-serif",
        "display": "Be Vietnam Pro, Segoe UI Variable, Segoe UI, ui-sans-serif, system-ui, -apple-system, Helvetica, Arial, sans-serif",
        "chat": "Be Vietnam Pro, Segoe UI Variable, Segoe UI, ui-sans-serif, system-ui, -apple-system, Helvetica, Arial, sans-serif",
        "mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
      },
      "size": {
        "caption": "0.75rem",
        "body_sm": "0.875rem",
        "body": "1rem",
        "heading": "1.25rem",
        "title": "1.5rem",
        "display": "2rem"
      },
      "line_height": {
        "tight": "1.25",
        "snug": "1.375",
        "normal": "1.5",
        "relaxed": "1.625"
      },
      "weight": {
        "regular": "400",
        "medium": "500",
        "semibold": "600",
        "bold": "700"
      }
    },
    "elevation": {
      "canvas": "none",
      "card": "none",
      "float": "0 8px 24px -12px rgba(0, 0, 0, 0.2)",
      "overlay": "0 16px 36px -16px rgba(0, 0, 0, 0.35)",
      "focus": "0 0 0 2px rgba(164, 201, 255, 0.15)"
    },
    "status": {
      "ok": {
        "bg": "rgba(164, 201, 255, 0.12)",
        "border": "rgba(164, 201, 255, 0.28)",
        "text": "#A4C9FF",
        "icon": "check"
      },
      "warn": {
        "bg": "rgba(250, 189, 52, 0.12)",
        "border": "rgba(250, 189, 52, 0.30)",
        "text": "#FABD34",
        "icon": "warning"
      },
      "danger": {
        "bg": "rgba(255, 180, 171, 0.12)",
        "border": "rgba(255, 180, 171, 0.30)",
        "text": "#FFB4AB",
        "icon": "warning"
      },
      "info": {
        "bg": "rgba(164, 201, 255, 0.12)",
        "border": "rgba(164, 201, 255, 0.28)",
        "text": "#A4C9FF",
        "icon": "clinical-notes"
      },
      "neutral": {
        "bg": "rgba(139, 145, 157, 0.16)",
        "border": "rgba(139, 145, 157, 0.30)",
        "text": "#C1C7D3",
        "icon": "more"
      }
    },
    "health_state": {
      "confirmed": {
        "label_vi": "Bác sĩ xác nhận",
        "label_en": "Clinician confirmed",
        "tone": "ok",
        "icon": "check"
      },
      "user_reported": {
        "label_vi": "Người dùng ghi nhận",
        "label_en": "Self-reported",
        "tone": "neutral",
        "icon": "user-card"
      },
      "imported": {
        "label_vi": "Nhập từ hồ sơ",
        "label_en": "Imported record",
        "tone": "brand",
        "icon": "folder"
      },
      "device": {
        "label_vi": "Từ thiết bị đo",
        "label_en": "Device measurement",
        "tone": "brand",
        "icon": "scan"
      },
      "unconfirmed": {
        "label_vi": "Chưa xác nhận",
        "label_en": "Unconfirmed",
        "tone": "warn",
        "icon": "help"
      },
      "stopped": {
        "label_vi": "Đã ngưng",
        "label_en": "Stopped",
        "tone": "neutral",
        "icon": "stop"
      },
      "conflict": {
        "label_vi": "Có mâu thuẫn",
        "label_en": "In conflict",
        "tone": "danger",
        "icon": "warning"
      },
      "stale": {
        "label_vi": "Cần cập nhật",
        "label_en": "Needs update",
        "tone": "warn",
        "icon": "calendar"
      }
    },
    "source_state": {
      "verified": {
        "label_vi": "Đã kiểm chứng",
        "label_en": "Verified",
        "tone": "ok",
        "icon": "check"
      },
      "self_reported": {
        "label_vi": "Tự ghi nhận",
        "label_en": "Self-reported",
        "tone": "neutral",
        "icon": "user-card"
      },
      "imported": {
        "label_vi": "Nhập từ hồ sơ",
        "label_en": "Imported",
        "tone": "brand",
        "icon": "folder"
      },
      "device": {
        "label_vi": "Thiết bị y tế",
        "label_en": "Medical device",
        "tone": "brand",
        "icon": "scan"
      },
      "pending": {
        "label_vi": "Chờ đối chiếu",
        "label_en": "Pending verification",
        "tone": "warn",
        "icon": "progress"
      },
      "unverified": {
        "label_vi": "Chưa xác minh",
        "label_en": "Unverified",
        "tone": "neutral",
        "icon": "help"
      }
    }
  }
}