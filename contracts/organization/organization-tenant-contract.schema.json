{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theclaracare.com/schemas/organization/organization-tenant-contract.schema.json",
  "title": "OrganizationTenantContract",
  "description": "JSON schema specifying tenant organization and collaborative workspace entity contracts, CRUD payloads, and status lifecycles in CLARA Care.",
  "type": "object",
  "required": [
    "schema_version",
    "entities",
    "crud_contracts",
    "rbac_roles"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^v[0-9]+(\\.[0-9]+)*$"
    },
    "entities": {
      "type": "object",
      "required": ["Organization", "OrganizationMember", "TenantWorkspace"],
      "properties": {
        "Organization": {
          "type": "object",
          "required": ["id", "name", "slug", "tier", "status", "created_at", "updated_at"],
          "properties": {
            "id": { "type": "string", "pattern": "^org_[a-z0-9_-]{3,32}$" },
            "name": { "type": "string", "minLength": 2, "maxLength": 150 },
            "slug": { "type": "string", "pattern": "^[a-z0-9_-]{3,64}$" },
            "description": { "type": "string" },
            "tier": { "type": "string", "enum": ["free", "standard", "professional", "enterprise", "research_pilot"] },
            "status": { "type": "string", "enum": ["active", "suspended", "maintenance", "quarantined", "deprovisioned"] },
            "contact_email": { "type": ["string", "null"] },
            "created_at": { "type": "string", "format": "date-time" },
            "updated_at": { "type": "string", "format": "date-time" }
          }
        },
        "OrganizationMember": {
          "type": "object",
          "required": ["id", "org_id", "user_email", "role", "status", "created_at"],
          "properties": {
            "id": { "type": "string", "pattern": "^mem_[a-z0-9_-]+$" },
            "org_id": { "type": "string", "pattern": "^org_[a-z0-9_-]+$" },
            "user_id": { "type": ["integer", "null"] },
            "user_email": { "type": "string", "format": "email" },
            "role": { "type": "string", "enum": ["owner", "admin", "workspace_lead", "clinician", "researcher", "auditor", "member", "viewer"] },
            "status": { "type": "string", "enum": ["invited", "active", "suspended"] },
            "joined_at": { "type": ["string", "null"], "format": "date-time" },
            "created_at": { "type": "string", "format": "date-time" }
          }
        },
        "TenantWorkspace": {
          "type": "object",
          "required": ["id", "org_id", "name", "slug", "is_restricted", "is_archived", "created_at", "updated_at"],
          "properties": {
            "id": { "type": "string", "pattern": "^ws_[a-z0-9_-]+$" },
            "org_id": { "type": "string", "pattern": "^org_[a-z0-9_-]+$" },
            "name": { "type": "string", "minLength": 1, "maxLength": 120 },
            "slug": { "type": "string", "pattern": "^[a-z0-9_-]{2,64}$" },
            "description": { "type": "string" },
            "is_restricted": { "type": "boolean" },
            "is_archived": { "type": "boolean" },
            "created_at": { "type": "string", "format": "date-time" },
            "updated_at": { "type": "string", "format": "date-time" }
          }
        }
      }
    },
    "crud_contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["method", "path", "operation", "required_role", "idempotency"],
        "properties": {
          "method": { "type": "string", "enum": ["GET", "POST", "PATCH", "PUT", "DELETE"] },
          "path": { "type": "string" },
          "operation": { "type": "string" },
          "required_role": { "type": "string" },
          "idempotency": { "type": "boolean" },
          "description": { "type": "string" }
        }
      }
    },
    "rbac_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "scope", "permissions"],
        "properties": {
          "role": { "type": "string" },
          "scope": { "type": "string" },
          "permissions": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
