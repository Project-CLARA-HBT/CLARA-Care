{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://theclaracare.com/schemas/agent-execution/agent-manifest.schema.json",
  "title": "AgentExecutionManifest",
  "description": "Canonical contract schema validating execution manifests for 10 concurrent subagents (A01-A10) across phase worktrees in CLARA.",
  "type": "object",
  "required": [
    "phase_id",
    "agent_id",
    "base_sha",
    "branch",
    "files_changed",
    "tests_run",
    "status",
    "rollback_steps"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON schema reference URI"
    },
    "phase_id": {
      "type": "string",
      "pattern": "^PH[0-9]{2}$",
      "description": "Project phase identifier (e.g., PH00, PH01, PH02)"
    },
    "agent_id": {
      "type": "string",
      "enum": [
        "A01",
        "A02",
        "A03",
        "A04",
        "A05",
        "A06",
        "A07",
        "A08",
        "A09",
        "A10"
      ],
      "description": "Identifier of the subagent, strictly one of A01 through A10"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$",
      "description": "40-character hexadecimal ground-truth commit SHA"
    },
    "frozen_head_sha": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{40}$",
      "description": "Alias for base_sha representing frozen head commit SHA"
    },
    "branch": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_\\-./]+$",
      "description": "Git branch name assigned to the subagent worktree"
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "List of repository file paths created, modified, or deleted by this agent"
    },
    "tests_run": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "description": "Test command string"
          },
          {
            "type": "object",
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1,
                "description": "The exact shell command executed"
              },
              "exit_code": {
                "type": "integer",
                "description": "Process exit code (0 for PASS)"
              },
              "status": {
                "type": "string",
                "enum": [
                  "PASSED",
                  "FAILED",
                  "NOT_RUN",
                  "PASS",
                  "FAIL"
                ],
                "description": "Individual test execution result"
              },
              "output": {
                "type": "string",
                "description": "Truncated command stdout/stderr summary"
              },
              "duration_seconds": {
                "type": "number",
                "minimum": 0,
                "description": "Execution time in seconds"
              }
            },
            "required": [
              "command"
            ],
            "additionalProperties": true
          }
        ]
      },
      "description": "List of executed test suites, commands, or execution records"
    },
    "status": {
      "type": "string",
      "enum": [
        "PASSED",
        "FAILED",
        "BLOCKED"
      ],
      "description": "Terminal status of the agent task (PASSED, FAILED, or BLOCKED)"
    },
    "rollback_steps": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "description": "Ordered procedural commands to revert agent changes"
        },
        {
          "type": "string",
          "minLength": 1,
          "description": "Multi-line string describing procedural rollback instructions"
        }
      ],
      "description": "Procedural steps or shell commands required to safely rollback the agent's changes"
    },
    "role": {
      "type": "string",
      "description": "Assigned subagent role description (e.g. 'API + contract')"
    },
    "task": {
      "type": "string",
      "description": "One-line task description assigned to the subagent"
    },
    "worktree_path": {
      "type": "string",
      "description": "Filesystem path to the subagent worktree (e.g. /dev/shm/clara_worktrees/PH02_A01)"
    },
    "path_lane": {
      "type": "string",
      "description": "Authorized path lane for subagent file modifications"
    },
    "handoff_commit": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{7,40}$",
      "description": "Git commit SHA delivered by this agent on its branch"
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of blockers if status is BLOCKED"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Deliverable artifact paths produced by the subagent"
    },
    "interface_assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Assumptions made regarding contracts, schemas, or peer subagents"
    },
    "verified_source_anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string"
          },
          "line_start": {
            "type": "integer"
          },
          "line_end": {
            "type": "integer"
          },
          "symbol": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "file"
        ]
      },
      "description": "List of inspected or modified source code anchors (file, lines, symbol)"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 generation timestamp"
    }
  },
  "additionalProperties": true
}
