{
  "name": "clara-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20 <21",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "consumer-terminology:generate": "node scripts/generate-consumer-terminology.mjs",
    "consumer-terminology:check": "node scripts/generate-consumer-terminology.mjs --check && node scripts/check-consumer-terminology-contract.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "route-matrix:check": "node scripts/check-route-capability-matrix.mjs",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "test:e2e:visual": "playwright test e2e/visual.spec.ts",
    "bundle:check": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.13.23",
    "axios": "^1.14.0",
    "docx": "^9.1.1",
    "html-to-image": "^1.11.13",
    "material-symbols": "^0.44.2",
    "mermaid": "10.9.6",
    "next": "15.5.22",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "20.16.5",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.14",
    "fast-check": "^3.23.2",
    "jsdom": "^25.0.1",
    "postcss": "8.5.25",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "postcss": "8.5.25",
    "next@15.5.22": {
      "sharp": "0.35.3"
    }
  }
}
