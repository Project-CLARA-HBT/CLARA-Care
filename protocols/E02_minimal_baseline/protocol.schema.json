{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "glhs-minimal-baseline-protocol.v1",
  "description": "Frozen protocol for GLHS E02 minimal alternative-design baseline comparator evaluation.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "freeze_id",
    "git_sha",
    "code_revision",
    "protocol_hash",
    "analysis_plan_hash",
    "environment",
    "arms",
    "arm_definitions",
    "schedule_inventory",
    "schedule_families",
    "primary_analysis",
    "freeze_utc"
  ],
  "properties": {
    "schema_version": { "const": "glhs-minimal-baseline-protocol.v1" },
    "status": { "const": "FROZEN" },
    "freeze_id": { "type": "string", "pattern": "^GLHS-MINIMAL-BASELINE-[0-9]{8}-[0-9]{2}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "code_revision": { "type": "string" },
    "protocol_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "analysis_plan_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "environment": { "type": "object" },
    "arms": {
      "type": "array",
      "items": { "enum": ["GLHS_B111", "MIN_READSET_TOKEN", "HMAC_READSET_TOKEN", "B000"] },
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true
    },
    "arm_definitions": {
      "type": "object"
    },
    "schedule_inventory": {
      "type": "object",
      "required": ["total", "adversarial", "controls", "per_family", "schedules_sha256"],
      "properties": {
        "total": { "const": 352 },
        "adversarial": { "const": 256 },
        "controls": { "const": 96 },
        "per_family": { "type": "object" },
        "schedules_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "schedule_families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["family_id", "name", "definition", "disclosure_delta_type"],
        "properties": {
          "family_id": { "type": "integer", "minimum": 1, "maximum": 9 },
          "name": { "type": "string" },
          "definition": { "type": "string" },
          "disclosure_delta_type": { "type": "string" }
        }
      },
      "minItems": 9
    },
    "primary_analysis": {
      "type": "object",
      "required": [
        "endpoint",
        "comparators",
        "total_executions",
        "controls",
        "decision_agreement",
        "byte_overhead_comparison",
        "validation_latency",
        "adaptive_sample_size"
      ],
      "properties": {
        "endpoint": { "type": "string" },
        "comparators": { "type": "array" },
        "total_executions": { "const": 1408 },
        "controls": { "type": "string" },
        "decision_agreement": { "type": "string" },
        "byte_overhead_comparison": { "type": "string" },
        "validation_latency": { "type": "string" },
        "adaptive_sample_size": { "const": false }
      }
    },
    "freeze_utc": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
