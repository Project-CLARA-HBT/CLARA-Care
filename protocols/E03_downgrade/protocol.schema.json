{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "glhs-downgrade-assurance-protocol.v1",
  "description": "Frozen protocol for GLHS E03 Downgrade and Lineage Anti-Laundering Assurance evaluation.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "freeze_id",
    "git_sha",
    "code_revision",
    "protocol_hash",
    "analysis_plan_hash",
    "environment",
    "schedule_inventory",
    "laundering_patterns",
    "primary_analysis",
    "freeze_utc"
  ],
  "properties": {
    "schema_version": { "const": "glhs-downgrade-assurance-protocol.v1" },
    "status": { "const": "FROZEN" },
    "freeze_id": { "type": "string", "pattern": "^GLHS-DOWNGRADE-ASSURANCE-[0-9]{8}-[0-9]{2}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "code_revision": { "type": "string" },
    "protocol_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "analysis_plan_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "environment": { "type": "object" },
    "schedule_inventory": {
      "type": "object",
      "required": ["total", "adversarial_negative", "clean_controls", "per_pattern", "schedules_sha256"],
      "properties": {
        "total": { "const": 300 },
        "adversarial_negative": { "const": 250 },
        "clean_controls": { "const": 50 },
        "per_pattern": { "type": "object" },
        "schedules_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "laundering_patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pattern_id", "code", "name", "threat_vector", "expected_outcome", "rejection_reason_code"],
        "properties": {
          "pattern_id": { "type": "integer", "minimum": 1, "maximum": 11 },
          "code": { "type": "string" },
          "name": { "type": "string" },
          "threat_vector": { "type": "string" },
          "expected_outcome": { "enum": ["REJECT", "ADMIT"] },
          "rejection_reason_code": { "type": "string" }
        }
      },
      "minItems": 11
    },
    "primary_analysis": {
      "type": "object",
      "required": [
        "endpoint",
        "downgrade_success_threshold",
        "clean_control_target_rate",
        "total_executions",
        "route_inventory_scope",
        "fail_closed_criteria",
        "adaptive_sample_size"
      ],
      "properties": {
        "endpoint": { "type": "string" },
        "downgrade_success_threshold": { "const": 0 },
        "clean_control_target_rate": { "const": 1.0 },
        "total_executions": { "const": 300 },
        "route_inventory_scope": { "type": "string" },
        "fail_closed_criteria": { "type": "string" },
        "adaptive_sample_size": { "const": false }
      }
    },
    "freeze_utc": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
