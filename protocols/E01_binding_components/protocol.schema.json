{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "glhs-binding-component-ablation-protocol.v1",
  "description": "Frozen protocol for GLHS E01 2^3 factorial component-wise exact-binding ablation.",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "freeze_id",
    "git_sha",
    "code_revision",
    "protocol_hash",
    "analysis_plan_hash",
    "environment",
    "arms",
    "arm_definitions",
    "schedule_inventory",
    "schedule_families",
    "primary_analysis",
    "freeze_utc"
  ],
  "properties": {
    "schema_version": { "const": "glhs-binding-component-ablation-protocol.v1" },
    "status": { "const": "FROZEN" },
    "freeze_id": { "type": "string", "pattern": "^GLHS-BINDING-COMPONENT-ABLATION-[0-9]{8}-[0-9]{2}$" },
    "git_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "code_revision": { "type": "string" },
    "protocol_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "analysis_plan_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "environment": { "type": "object" },
    "arms": {
      "type": "array",
      "items": { "enum": ["B000", "B100", "B010", "B001", "B110", "B101", "B011", "B111"] },
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true
    },
    "arm_definitions": {
      "type": "object"
    },
    "schedule_inventory": {
      "type": "object",
      "required": ["total", "adversarial", "controls", "per_family", "schedules_sha256"],
      "properties": {
        "total": { "const": 352 },
        "adversarial": { "const": 256 },
        "controls": { "const": 96 },
        "per_family": { "type": "object" },
        "schedules_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "schedule_families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["family_id", "name", "definition", "disclosure_delta_type"],
        "properties": {
          "family_id": { "type": "integer", "minimum": 1, "maximum": 9 },
          "name": { "type": "string" },
          "definition": { "type": "string" },
          "disclosure_delta_type": { "type": "string" }
        }
      },
      "minItems": 9
    },
    "primary_analysis": {
      "type": "object",
      "required": [
        "endpoint",
        "numerator",
        "denominator",
        "risk_difference",
        "ci95",
        "discordant_counts",
        "exact_mcnemar",
        "factorial_logistic_regression",
        "per_family",
        "controls",
        "adaptive_sample_size"
      ],
      "properties": {
        "endpoint": { "type": "string" },
        "numerator": { "type": "string" },
        "denominator": { "const": 256 },
        "risk_difference": { "type": "string" },
        "ci95": { "type": "string" },
        "discordant_counts": { "type": "string" },
        "exact_mcnemar": { "type": "string" },
        "factorial_logistic_regression": { "type": "string" },
        "per_family": { "type": "string" },
        "controls": { "type": "string" },
        "adaptive_sample_size": { "const": false },
        "bootstrap_seed": { "type": "integer" },
        "bootstrap_iterations": { "type": "integer", "const": 10000 }
      }
    },
    "freeze_utc": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
