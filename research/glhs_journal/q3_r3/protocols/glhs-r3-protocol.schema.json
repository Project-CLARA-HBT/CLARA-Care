{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Project-CLARA-HBT/CLARA-Care/main/research/glhs_journal/q3_r3/protocols/glhs-r3-protocol.schema.json",
  "title": "GLHS R3 Unified Protocol Specification Schema",
  "description": "Unified JSON schema enforcing required standard metadata, formal invariant linkages, backend engine assertions, and statistical endpoint definitions across GLHS R3 experiments (E00-E14).",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_id",
    "experiment_id",
    "priority",
    "freeze_id",
    "freeze_timestamp_utc",
    "git_sha",
    "target_invariants",
    "backend_requirement",
    "scientific_unit",
    "primary_endpoints",
    "secondary_endpoints",
    "sample_size",
    "statistical_plan",
    "stopping_rules",
    "artifact_layout"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["glhs-r3-protocol.v1"]
    },
    "protocol_id": {
      "type": "string",
      "pattern": "^GLHS-R3-E(0[0-9]|1[0-4])-[A-Z0-9_]+$"
    },
    "experiment_id": {
      "type": "string",
      "enum": [
        "E00", "E01", "E02", "E03", "E04",
        "E05", "E06", "E07", "E08", "E09",
        "E10", "E11", "E12", "E13", "E14"
      ]
    },
    "priority": {
      "type": "string",
      "enum": ["P0", "P1", "P2"]
    },
    "freeze_id": {
      "type": "string",
      "pattern": "^GLHS-R3-E(0[0-9]|1[0-4])-FREEZE-[0-9]{8}-V[0-9]+$"
    },
    "freeze_timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "target_invariants": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "I01_state_isolation",
          "I02_governance_freshness",
          "I03_phantom_free",
          "I04_deadlock_free",
          "I05_idempotency_atomicity",
          "I06_cas_monotonicity",
          "I07_evidence_closure",
          "I08_binding_immutability",
          "I09_lineage_preservation",
          "I10_dependency_completeness",
          "I11_no_weak_route_downgrade",
          "I12_exact_inference_disclosure_continuity",
          "I13_non_downgradable_human_lineage",
          "I14_undisclosed_evidence_rejection",
          "I15_clean_path_reachability"
        ]
      },
      "uniqueItems": true
    },
    "backend_requirement": {
      "type": "string",
      "enum": [
        "static_claim_audit",
        "real_postgresql_16",
        "cross_runtime_node_python",
        "bounded_model_checker",
        "live_llm_provider_ledger",
        "external_corpus_evaluator",
        "hermetic_reproduction_engine"
      ]
    },
    "scientific_unit": {
      "type": "string",
      "minLength": 1
    },
    "primary_endpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/endpoint_spec"
      }
    },
    "secondary_endpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/endpoint_spec"
      }
    },
    "sample_size": {
      "type": "object",
      "required": ["total_executions_N"],
      "properties": {
        "total_executions_N": {
          "type": "integer",
          "minimum": 1
        },
        "unit_definition": {
          "type": "string"
        },
        "schedule_breakdown": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "statistical_plan": {
      "type": "object",
      "required": ["method", "confidence_level"],
      "properties": {
        "method": {
          "type": "string"
        },
        "confidence_level": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 0.999
        },
        "hypothesis_testing": {
          "type": "object"
        },
        "confidence_bounds": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "stopping_rules": {
      "type": "object",
      "required": ["fail_closed_criteria", "missing_data_rule"],
      "properties": {
        "fail_closed_criteria": {
          "type": "string"
        },
        "missing_data_rule": {
          "type": "string"
        },
        "safety_halt_threshold": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "artifact_layout": {
      "type": "object",
      "required": ["required_artifacts"],
      "properties": {
        "required_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifact_directory": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "endpoint_spec": {
      "type": "object",
      "required": ["name", "definition"],
      "properties": {
        "name": {
          "type": "string"
        },
        "definition": {
          "type": "string"
        },
        "target_value": {
          "type": ["number", "string", "boolean", "null"]
        },
        "acceptable_threshold": {
          "type": ["number", "string", "boolean", "null"]
        },
        "hypothesis": {
          "type": "object"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
