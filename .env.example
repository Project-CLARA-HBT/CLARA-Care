# =====================================================
# CLARA - Local Development Environment (P0)
# =====================================================
ENV=development
LOG_LEVEL=INFO
TZ=Asia/Ho_Chi_Minh

# -----------------------------
# CLARA-Eval VN (references only; never put patient data or secrets in reports)
# -----------------------------
# Optional approved service endpoints used by an external governed live/locked
# evaluator. Keep the manifest outside the repository: request/response bodies,
# credentials and raw case IDs are never written to the artifact report.
CLARA_EVAL_API_BASE_URL=
CLARA_EVAL_ML_BASE_URL=
CLARA_EVAL_LOCKED_DATASET_REF=
CLARA_EVAL_LOCKED_DATASET_TOKEN=
CLARA_EVAL_LIVE_EXECUTION_ENABLED=false
CLARA_EVAL_LIVE_MANIFEST=
CLARA_EVAL_LIVE_TIMEOUT_SECONDS=20
CLARA_EVAL_API_BEARER_TOKEN=
CLARA_EVAL_ML_BEARER_TOKEN=
CLARA_EVAL_ML_INTERNAL_KEY=
# Local isolated development only; production/live evaluation requires HTTPS.
CLARA_EVAL_ALLOW_INSECURE_HTTP=false

# -----------------------------
# API / Web / ML Runtime
# -----------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
ML_SERVICE_URL=http://ml:8010
ML_SERVICE_TIMEOUT_SECONDS=60
ML_SCRIBE_TIMEOUT_SECONDS=180
ML_RESEARCH_TIMEOUT_SECONDS=300
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_API_ALLOW_CROSS_ORIGIN=false
NEXT_PUBLIC_AUTH_CLIENT_SESSION_COOKIE=clara_client_session
NEXT_PUBLIC_AUTH_ACCESS_COOKIE=clara_access_token
NEXT_PUBLIC_AUTH_REFRESH_COOKIE=clara_refresh_token
NEXT_PUBLIC_AUTH_CSRF_COOKIE=clara_csrf_token
ML_HOST=0.0.0.0
ML_PORT=8010
WEB_PORT=3000
APP_API_PORT=8100
APP_WEB_PORT=3100
APP_ML_PORT=8110
APP_ASR_PORT=8190
SCRIBE_ASR_TIMEOUT_SECONDS=150
APP_SEARXNG_PORT=8888
# Local-only SearXNG signing key. Production requires a unique high-entropy
# SEARXNG_SECRET from the managed secret store; never reuse this placeholder.
SEARXNG_SECRET=local-development-searxng-secret-change-before-deploy
API_UVICORN_WORKERS=4
ML_UVICORN_WORKERS=8
RESEARCH_JOB_MAX_WORKERS=8
# Research source metadata is provenance-only. It does not emit formal GRADE
# certainty or recommendation-strength claims. Keep disabled until the
# professional evidence-metadata view has been reviewed in staging.
RESEARCH_EVIDENCE_SIGNALS_ENABLED=false

# Database connection-pool sizing (Requirement 10.2). Defaults below match the
# in-code SQLAlchemy defaults so behavior is preserved when unset; size relative
# to API_UVICORN_WORKERS for production. pool_pre_ping stays on as the liveness
# check. DB_POOL_RECYCLE=-1 disables recycling (SQLAlchemy default).
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# -----------------------------
# Auth
# -----------------------------
JWT_SECRET_KEY=change_me_super_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=43200
AUTH_AUTO_PROVISION_USERS=true
AUTH_BOOTSTRAP_ADMIN_ENABLED=false
AUTH_BOOTSTRAP_ADMIN_EMAIL=
AUTH_BOOTSTRAP_ADMIN_PASSWORD=Clara#Admin2026!
AUTH_BOOTSTRAP_ADMIN_FORCE_RESET_PASSWORD=false
AUTH_REQUIRE_EMAIL_VERIFICATION=false
AUTH_COOKIE_ACCESS_NAME=clara_access_token
AUTH_COOKIE_REFRESH_NAME=clara_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_REFRESH_REJECT_CONFLICT=false
# Distributed login throttling across API replicas (Requirement 5). The default
# `false` uses an in-process guard that is NOT shared between replicas, so a
# multi-replica deployment effectively multiplies the per-actor login allowance
# by the replica count (insecure-by-omission). RECOMMENDED PRODUCTION: set to
# `true` together with RATE_LIMIT_DISTRIBUTED_ENABLED=true and a reachable
# REDIS_URL so login throttling is enforced cluster-wide. See the limiter block
# under "Rate limits / caching" and docs/runbooks/platform-hardening-rollout.md.
AUTH_LOGIN_DISTRIBUTED_ENABLED=false
AUTH_LOGIN_OTP_ENABLED=false
AUTH_LOGIN_OTP_ROLES=doctor,admin
AUTH_LOGIN_OTP_TTL_MINUTES=5
# Untrusted PHR OCR and Research documents always pass deterministic
# filename/MIME/magic-byte checks. Turn this on only after a reachable ClamAV
# service is provisioned: when enabled, an unavailable/ambiguous scanner
# rejects the upload (503) rather than accepting it without a verdict.
UPLOAD_MALWARE_SCAN_REQUIRED=false
UPLOAD_MALWARE_CLAMAV_HOST=
UPLOAD_MALWARE_CLAMAV_PORT=3310
# Distributed global IP+path rate limiting across API replicas (Requirement 5).
# Default `false` keeps the limiter in-process (per-replica), which under-counts
# traffic in a multi-replica deployment. RECOMMENDED PRODUCTION: `true` with a
# reachable REDIS_URL so the configured cap is enforced across every replica.
RATE_LIMIT_DISTRIBUTED_ENABLED=false
SECURITY_REDIS_KEY_PREFIX=clara:sec
MEDICAL_DISCLAIMER_VERSION=2026-04-v1

# -----------------------------
# Compose-exposed ports (override if conflict)
# -----------------------------
POSTGRES_PORT=5432
REDIS_PORT=6379
MILVUS_PORT=19530
MILVUS_METRICS_PORT=9091
ELASTIC_PORT=9200
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# -----------------------------
# PostgreSQL
# -----------------------------
POSTGRES_USER=clara
POSTGRES_PASSWORD=clara_dev_password
POSTGRES_DB=clara
POSTGRES_HOST=localhost
DATABASE_URL=postgresql+psycopg://clara:clara_dev_password@localhost:5432/clara

# -----------------------------
# Redis
# -----------------------------
REDIS_HOST=localhost
REDIS_URL=redis://localhost:6379/0

# -----------------------------
# Milvus / Vector DB
# -----------------------------
MILVUS_HOST=localhost

# -----------------------------
# Elasticsearch
# -----------------------------
ELASTICSEARCH_URL=http://localhost:9200

# -----------------------------
# Neo4j
# -----------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=clara_dev_password
NEO4J_AUTH=neo4j/clara_dev_password

# -----------------------------
# MinIO (Milvus dependency)
# -----------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9000

# -----------------------------
# External API keys / credentials
# -----------------------------
OPENAI_API_KEY=your_openai_api_key
NCBI_API_KEY=your_ncbi_api_key
# UMLS UTS API key (NLM licensed). Used for UMLS/RxNorm-authenticated endpoints
# (RxClass, value sets). RxNorm normalization via public RxNav needs no key.
UMLS_API_KEY=your_umls_uts_api_key
WHO_ICD11_CLIENT_ID=your_who_client_id
WHO_ICD11_CLIENT_SECRET=your_who_client_secret
OPENFDA_API_KEY=your_openfda_api_key_optional
# Licensed DrugBank data is packaged server-side as a validated SQLite index;
# never expose or commit the XML/API key/client-side payload. The SQLite layer
# is the authoritative DDI source and OpenFDA is corroboration only.
CAREGUARD_DRUGBANK_SQLITE_ENABLED=true
CAREGUARD_DRUGBANK_REQUIRED=false
# Host directory containing the licensed, checksum-bearing artifact bundle.
# Docker mounts this only into ML at /var/lib/clara/drugbank; never commit its
# XML, shards, SQLite index, or license material. Leave REQUIRED=false until
# this directory is provisioned and health/details reports a ready full index.
CAREGUARD_DRUGBANK_ARTIFACT_HOST_DIR=/secure/clara/drugbank
CAREGUARD_DRUGBANK_MANIFEST_PATH=/var/lib/clara/drugbank/manifest.json
CAREGUARD_DRUGBANK_SQLITE_PATH=/var/lib/clara/drugbank/ddi_index.sqlite
# Require a signed-by-digest DrugBank artifact manifest (source release + input
# checksum + per-shard checksums). Set false only for a short audited rollback
# to a verified legacy artifact; production clinical strict mode uses true.
CAREGUARD_DRUGBANK_MANIFEST_INTEGRITY_REQUIRED=true
# Additive structured consumer wording after final deterministic CareGuard
# facts. Keep OFF until the presentation rollout is approved; this never
# replaces DrugBank or changes the authoritative DDI result.
CAREGUARD_WORDING_RENDERER_ENABLED=false
CAREGUARD_DRUGBANK_ENABLED=false
CAREGUARD_DDI_INDEX_ENABLED=true
EXTERNAL_DDI_ENABLED=false
EXTERNAL_DDI_TIMEOUT_SECONDS=1.5
CLINICALTRIALS_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.yescale.vip
# `DEEPSEEK_MODEL` is retained as the immediate legacy rollback target. The
# task registry normally selects the two governed V4 variants below: Pro for
# safety/reasoning and Flash for bounded extraction, reranking and planning.
# Neither selection may be controlled by an end-user request.
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
DEEPSEEK_FLASH_MODEL=deepseek-v4-flash
# Audio transcription has a separate governed ASR contract. It must stay an
# audio-capable model and is never substituted with a V4 text model.
DEEPSEEK_AUDIO_MODEL=whisper-1
# Legacy fallback when task routing is disabled. With task routing enabled the
# registered Pro/Flash counterpart is used instead, never the same model twice.
DEEPSEEK_FALLBACK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_RETRIES_PER_BASE=2
DEEPSEEK_RETRY_BACKOFF_SECONDS=1.0
LLM_DEEPSEEK_ONLY=true
# Typed task registry. Disable task routing to restore the single
# `DEEPSEEK_MODEL` path immediately; force rollback selects only an explicitly
# configured prior DeepSeek model. The registry never accepts a model from an
# end-user request.
MODEL_REGISTRY_ENABLED=true
MODEL_REGISTRY_TASK_MODEL_ROUTING_ENABLED=true
MODEL_REGISTRY_FORCE_ROLLBACK=false
MODEL_REGISTRY_ROLLBACK_MODEL=
# Use the governed V4 semantic classifier for non-emergency chat intent after
# deterministic emergency/legal guards. Set false for an immediate rollback to
# the legacy keyword intent path; it never disables those safety guards.
SEMANTIC_INTENT_ROUTING_ENABLED=true
# Optional V4 Flash Vietnamese clinical-language source-span packet. It is
# review/metadata-only and cannot replace emergency/legal guards, DrugBank,
# consent, RBAC, or LifeMap confirmation. Disable for an immediate rollback.
CLINICAL_LANGUAGE_LLM_EXTRACTION_ENABLED=false
# Send only validated exact medication spans from original CareGuard input to
# the deterministic Vietnamese/DrugBank normalizer. No LLM drug normalization
# or DDI conclusion is allowed. Keep off for shadow-only language rollout.
CAREGUARD_CLINICAL_SPAN_AUGMENTATION_ENABLED=false
# Optional external Vietnamese Encoder-SLM. This is shadow-only, disabled by
# default, and cannot affect safety decisions or the returned answer. Keep its
# URL/key in deployment secrets; turn it off immediately to roll back.
ENCODER_SLM_SHADOW_ENABLED=false
ENCODER_SLM_SHADOW_URL=
ENCODER_SLM_SHADOW_API_KEY=
ENCODER_SLM_SHADOW_MODEL_ID=
ENCODER_SLM_SHADOW_TIMEOUT_MS=750
ENCODER_SLM_SHADOW_MAX_INPUT_CHARS=1200
COUNCIL_LLM_SHADOW_ENABLED=false
# Deterministic fixed-weight Council signal for offline comparison only. It is
# not a neural model, exposes only a categorical band, and never changes
# emergency routing or the released Council recommendation. Legacy
# COUNCIL_NEURAL_* variables are accepted input aliases during rollout.
COUNCIL_RULE_SHADOW_ENABLED=false
COUNCIL_RULE_SHADOW_MODE=true
COUNCIL_RULE_SHADOW_MEDIUM_THRESHOLD=0.45
COUNCIL_RULE_SHADOW_HIGH_THRESHOLD=0.72
COUNCIL_LLM_MAX_TOKENS=1200
DEEP_BETA_PASS_CAP=20
DEEP_BETA_REASONING_LLM_ENABLED=true
DEEP_BETA_REASONING_LLM_NODES=6
DEEP_BETA_REASONING_LLM_TIMEOUT_SECONDS=20
DEEP_BETA_REASONING_PARALLEL_WORKERS=3
DEEP_BETA_REASONING_ROUNDS=2
DEEP_BETA_GAP_FILL_MAX_PASSES=2
DEEP_BETA_GAP_FILL_MAX_QUERIES=8
DEEP_BETA_REPORT_LLM_ENABLED=true
DEEP_BETA_QUALITY_GATE_ENABLED=true
DEEP_BETA_QUALITY_GATE_TIMEOUT_SECONDS=18
DEEP_BETA_EVIDENCE_VERIFICATION_ENABLED=true
DEEP_BETA_EVIDENCE_VERIFICATION_TIMEOUT_SECONDS=22
EMBEDDING_API_KEY=
YESCALE_API_KEY=
EMBEDDING_BASE_URL=https://api.yescale.io/v1
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_TIMEOUT_SECONDS=6
RAG_EXTERNAL_CONNECTORS_ENABLED=true
RAG_EXTERNAL_TIMEOUT_SECONDS=4
RAG_BIOMEDICAL_RERANK_ENABLED=true
RAG_BIOMEDICAL_RERANK_ALPHA=0.28
RAG_BIOMEDICAL_RERANK_TOP_N=8
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL=phase1-skeleton-reranker-v0
RAG_RERANKER_TOP_N=12
RAG_RERANKER_TIMEOUT_MS=250
DEEP_BETA_LLM_REASONING_ENABLED=true
DEEP_BETA_LLM_REASONING_TIMEOUT_SECONDS=45
DEEP_BETA_LLM_CHAIN_MAX_STEPS=6
DEEP_BETA_LLM_GAP_FILL_PASSES=2
DEEP_BETA_REPORT_MIN_WORDS=20000
DEEP_BETA_REPORT_TARGET_PAGES=50
DEEP_BETA_REPORT_WORDS_PER_PAGE=500
DEEP_BETA_REPORT_EXPANSION_ROUNDS=6
DEEP_BETA_REPORT_TIMEOUT_SECONDS=180
DEEP_BETA_REPORT_MAX_TOKENS=12288
RAG_NLI_ENABLED=true
RAG_NLI_TIMEOUT_MS=180
RAG_NLI_MIN_CONFIDENCE=0.35
RAG_GRAPHRAG_ENABLED=false
SEARXNG_BASE_URL=
SEARXNG_PUBLIC_BASE_URL=http://127.0.0.1:8888/
SEARXNG_TIMEOUT_SECONDS=3
# OCR provider key nên đặt ở tgc-transhub.
# CLARA chỉ gọi OCR nội bộ qua endpoint của tgc-transhub.
TGC_OCR_BASE_URL=http://host.docker.internal:8080
TGC_OCR_ENDPOINTS=/api/ocr,/api/extract,/ocr
TGC_OCR_TIMEOUT_SECONDS=45
TGC_OCR_API_KEY=

# OCR adapter Google Vision (services/ocr) — xem services/ocr/README.md.
# Native local: TGC_OCR_BASE_URL=http://localhost:8080, TGC_OCR_ENDPOINTS=/ocr,/api/ocr,/api/extract
GCP_VISION_API_KEY=
# GCP_VISION_ENDPOINT=https://vision.googleapis.com/v1/images:annotate
# OCR_LANG_DEFAULT=vi

# -----------------------------
# RAG embedding default
#
# Generative task selection is governed exclusively by DEEPSEEK_PRO_MODEL and
# DEEPSEEK_FLASH_MODEL above. Do not add a generic router/synthesis model here:
# request payloads and user settings must not select a provider or model.
# -----------------------------
DEFAULT_EMBEDDING_MODEL=bge-m3

# -----------------------------
# Rate limits / caching
# -----------------------------
# Global IP+path limiter (Requirement 5). GLOBAL_RATE_LIMIT_PER_MIN is the
# per-actor cap per RATE_LIMIT_WINDOW_SECONDS window; the dev defaults below are
# permissive. RECOMMENDED PRODUCTION: tune GLOBAL_RATE_LIMIT_PER_MIN to your
# expected per-client traffic (the 120/min default is a starting point) and keep
# the 60s window. Multi-replica production MUST also set
# RATE_LIMIT_DISTRIBUTED_ENABLED=true + AUTH_LOGIN_DISTRIBUTED_ENABLED=true with
# a reachable REDIS_URL (see the Auth section), otherwise the cap is enforced
# per-replica only and the effective limit is multiplied by the replica count.
GLOBAL_RATE_LIMIT_PER_MIN=120
RATE_LIMIT_WINDOW_SECONDS=60
# Limiter fail-closed mode (Requirement 5.3). Default off preserves current
# behavior: if the distributed limiter backend (Redis) is unavailable the
# request passes through unthrottled. RECOMMENDED PRODUCTION: `true` so the
# limiter falls back to the in-process limiter and keeps enforcing the cap
# instead of disabling enforcement when the backend is down. Roll out per
# docs/runbooks/platform-hardening-rollout.md (default-off flag).
HARDENING_RATE_LIMIT_FAIL_CLOSED=false
# Proxy-trust resolution (Requirement 5.6). Client IPs are derived from
# forwarded headers (X-Forwarded-For) ONLY when the immediate peer is a trusted
# proxy; otherwise the direct peer address is used. Leave trust DISABLED unless
# the API sits behind a known reverse proxy/load balancer, otherwise clients can
# spoof their IP and evade per-actor limits. RECOMMENDED PRODUCTION (behind a
# trusted proxy/LB): set RATE_LIMIT_TRUST_PROXY_HEADERS=true AND pin
# RATE_LIMIT_TRUSTED_PROXIES to the proxy/LB host(s) or CIDR(s) so forwarded
# headers are honored only from those peers.
RATE_LIMIT_TRUST_PROXY_HEADERS=false
RATE_LIMIT_TRUSTED_PROXIES=
PUBMED_RATE_LIMIT_PER_SEC=10
CACHE_TTL_GENERAL_SEC=86400
CACHE_TTL_DRUG_SEC=21600

# -----------------------------
# Analytics SDK (web + mobile)
# -----------------------------
# Empty SDK provider/key → transmission disabled (graceful no-op).
# Provider options: posthog | ga | plausible | "" (empty)
ANALYTICS_SDK_PROVIDER=
ANALYTICS_SDK_KEY=
ANALYTICS_SDK_HOST=
# Client-exposed (NEXT_PUBLIC_*) values; empty → client analytics disabled (graceful no-op).
NEXT_PUBLIC_ANALYTICS_SDK_PROVIDER=
NEXT_PUBLIC_ANALYTICS_SDK_KEY=
NEXT_PUBLIC_ANALYTICS_SDK_HOST=

# -----------------------------
# CLARA Chat redesign (clara-chat-redesign, CHAT_V2)
# -----------------------------
# The rebuilt, componentized chat (apps/web/app/chat/_v2) is the DEFAULT as of
# the production rollout (task 8.3). The flag defaults ON when unset/empty.
# To roll back to the legacy chat page instantly (env-only, no code change),
# set this to an explicit opt-out value: false | 0 | off (case-insensitive).
# Leave unset (default ON) in staging/production; set =false only for rollback.
# See: docs/runbooks/chat-v2-rollout.md
NEXT_PUBLIC_CHAT_V2=

# -----------------------------
# Internal analytics dashboards
# -----------------------------
PRODUCT_ANALYTICS_ENABLED=true
CLINICAL_ANALYTICS_ENABLED=true
ANALYTICS_DEFAULT_RANGE_DAYS=30

# =====================================================
# Clara Scribe Enterprise — feature flags (SINGLE SOURCE OF TRUTH)
# =====================================================
# Every Scribe capability is additive + independently flag-gated. ALL flags
# default OFF ⇒ behavior is byte-for-byte the legacy batch transcribe + SOAP
# + CRUD flow (Requirement 11.1/11.2). Flip a flag back to false at runtime to
# roll back instantly without data loss (Requirement 11.3).
#
# Staged enablement is orchestrated by scripts/deploy/scribe_staged_rollout.sh
# (dry-run by default) per the runbook:
#   docs/hackathon/scribe-enterprise-staged-rollout-runbook-2026-04-20.md
# Rollout order (each stage applied ml -> api -> web):
#   1) grounding+extraction  2) E/M+CPT  3) quality+WER
#   4) FHIR+addendum  5) specialty templates  6) eval gate

# --- Wave 1 (R1–R11): default off/legacy ---
RAG_SCRIBE_STREAMING_ENABLED=false        # R1 ambient/streaming SSE transcription
RAG_SCRIBE_DIARIZATION_ENABLED=false      # R3 speaker labels (additive metadata)
RAG_SCRIBE_CONSENT_REQUIRED=false         # R4 explicit consent gate before transcription
RAG_SCRIBE_TEMPLATES_ENABLED=false        # R6 multi-template note generation
RAG_SCRIBE_CODING_ENABLED=false           # R7 ICD-10 + drug-safety assist (advisory)
RAG_SCRIBE_SIGN_WORKFLOW_ENABLED=false    # R8 review -> sign -> amend + audit trail
RAG_SCRIBE_EXPORT_ENABLED=false           # R9 md/docx export
RAG_SCRIBE_FHIR_EXPORT_ENABLED=false      # R9.3 FHIR DocumentReference shape

# ASR provider seam (provider selection + language). "whisper" resolves the
# registry-owned DEEPSEEK_AUDIO_MODEL above; it is distinct from V4 text routing.
# Other names degrade to it when unconfigured.
SCRIBE_ASR_PRIMARY=whisper
SCRIBE_ASR_FALLBACK=whisper
SCRIBE_ASR_LANGUAGE=vi
SCRIBE_ASR_CODE_SWITCHING=true            # R2.2 keep embedded English drug tokens verbatim
SCRIBE_MEDICAL_CORRECTION_ENABLED=false   # draft-only source-spanned ASR correction; clinician review required
# API never persists raw audio.  This optional, flag-gated endpoint clears a
# session's stored transcript/diarization metadata on a data-rights request.
RAG_SCRIBE_RECORDING_DATA_DELETION_ENABLED=false
SCRIBE_TRANSCRIPT_RETENTION_DAYS=0         # 0 = no automatic purge; schedule only after policy approval
SCRIBE_AUDIO_MAGIC_VALIDATION_ENABLED=false # staged upload-signature guard; enable with real-client compatibility check
SCRIBE_GOOGLE_PROJECT_ID=                 # Required only when SCRIBE_ASR_PRIMARY=google_stt_v2
SCRIBE_GOOGLE_LOCATION=us
SCRIBE_GOOGLE_RECOGNIZER=_
# PhoWhisper (self-hosted VN ASR) — empty base URL ⇒ disabled/degrades to Whisper.
SCRIBE_PHOWHISPER_BASE_URL=
SCRIBE_PHOWHISPER_API_KEY=
SCRIBE_PHOWHISPER_MODEL=phowhisper-large
SCRIBE_PHOWHISPER_TIMEOUT_SECONDS=30
SCRIBE_PHOWHISPER_RETRIES=1
SCRIBE_PHOWHISPER_RETRY_BACKOFF_SECONDS=0.25

# --- Wave 2 (R12–R20): default off ⇒ byte-for-byte current behavior ---
# Stage 1 — grounding + structured extraction (share the span model; ship together)
RAG_SCRIBE_GROUNDING_ENABLED=false             # R12 transcript grounding / claim traceability
RAG_SCRIBE_STRUCTURED_EXTRACTION_ENABLED=false # R13 structured clinical-data extraction
# Stage 2 — conservative E/M + CPT coding (anti-upcoding, advisory)
RAG_SCRIBE_EM_CPT_CODING_ENABLED=false         # R14 E/M visit-level + CPT suggestions
# Stage 3 — quality + WER reporting (observability, non-blocking)
RAG_SCRIBE_QUALITY_METRICS_ENABLED=false       # R15 note-quality + efficiency metrics (PII-free)
RAG_SCRIBE_WER_REPORTING_ENABLED=false         # R16 ASR word-error-rate / fairness reporting
# Stage 4 — FHIR Composition/Encounter export + addendum workflow
RAG_SCRIBE_FHIR_COMPOSITION_ENABLED=false      # R17 FHIR Composition + Encounter export
RAG_SCRIBE_ADDENDUM_ENABLED=false              # R18 time-stamped addendum (distinct from amend)
# Stage 5 — specialty / macro templates (pure-data registry)
RAG_SCRIBE_SPECIALTY_TEMPLATES_ENABLED=false   # R19 specialty templates + clinician macros
# Stage 6 — note-generation evaluation gate (offline/CI only)
RAG_SCRIBE_EVAL_GATE_ENABLED=false             # R20 golden-set eval gate (gates releases of 1–5)

# =====================================================
# Platform hardening (clara-platform-hardening) — feature flags
# =====================================================
# Every flag below is ADDITIVE and defaults to the value that PRESERVES current
# behavior. With all HARDENING_* flags off the system is byte-for-byte equivalent
# to the pre-hardening baseline (Requirements 11.1, 11.2). Enable per environment
# in the staged order documented in docs/ops/hardening-rollout.md; each flag is
# independently reversible (set back to false) without redeploying clinical code.
#
# NOTE: HARDENING_RATE_LIMIT_FAIL_CLOSED is documented in the limiter block under
# "Rate limits / caching" above (do not redefine it here). Worker counts
# (API_UVICORN_WORKERS / ML_UVICORN_WORKERS) and DB pool sizing
# (DB_POOL_SIZE / DB_MAX_OVERFLOW / DB_POOL_TIMEOUT / DB_POOL_RECYCLE /
# DB_POOL_PRE_PING) are documented near the top of this file (Requirement 10.1,
# 10.2); size the pool relative to the worker count in production.

# --- Session hardening (Requirement 2) ---
# Rotate + invalidate refresh tokens on every exchange. When on, presenting a
# prior (rotated) refresh token is rejected and a no-PII reuse-detection event is
# recorded. Default off ⇒ existing refresh behavior.
HARDENING_REFRESH_ROTATION_ENABLED=false
# Revoke jti on logout and consult a Redis-backed denylist on each request, so a
# logged-out token is rejected until its natural expiry. Requires a reachable
# REDIS_URL in multi-replica deployments. Default off ⇒ no denylist consulted.
HARDENING_TOKEN_DENYLIST_ENABLED=false
# Keep login throttling enforced when the distributed limiter backend is down,
# falling back to the in-process LoginGuard instead of disabling throttling.
# Default off ⇒ current behavior. RECOMMENDED PRODUCTION: true.
HARDENING_LOGIN_FAIL_CLOSED=false

# --- Input validation & request limits (Requirement 4) ---
# Enforce a maximum request body size, rejecting larger bodies with a 413-class
# JSON response. Default off ⇒ no body-size enforcement (ML _MAX_AUDIO_BYTES is
# preserved either way).
HARDENING_REQUEST_BODY_LIMIT_ENABLED=false
# Maximum request body size in bytes, enforced ONLY when the body-size limit is
# enabled. Default 10 MiB (10485760) is inert while the limit is off.
HARDENING_REQUEST_BODY_MAX_BYTES=10485760

# --- Health, readiness & graceful degradation (Requirement 6) ---
# Enable the dependency-aware GET /health/ready probe (checks DB, Redis if
# configured, and ML if critical), returning 200 ready or 503 not-ready with a
# no-PII reason code. Liveness /health is unchanged either way. Default off ⇒
# readiness returns the liveness shape.
HARDENING_READINESS_PROBE_ENABLED=false
# Open a circuit breaker around the DeepSeek/embedding client after repeated
# downstream failures, short-circuiting to the existing labeled local fallback
# for a cool-down window. This flag is read by BOTH the API and ML services.
# Default off ⇒ calls flow through the existing bounded retry path unchanged.
HARDENING_CIRCUIT_BREAKER_ENABLED=false
# Consecutive-failure count at which the breaker opens (ML-side). Inert while the
# breaker flag is off.
HARDENING_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
# Cool-down window (seconds) the breaker stays open before a half-open recovery
# probe (ML-side). Inert while the breaker flag is off.
HARDENING_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# --- Structured logging without PII (Requirement 7) ---
# Install a JSON log formatter + redaction filter + per-request correlation id.
# The redaction filter reuses the compliance redaction projection so logs/metrics
# never carry PII. Default off ⇒ current logging configuration stands.
HARDENING_STRUCTURED_LOGGING_ENABLED=false

# --- Security headers (Requirement 7 / web hardening) ---
# Emit a Content-Security-Policy response header. Default off ⇒ no CSP header
# added (existing security headers are unchanged).
HARDENING_CSP_ENABLED=false

# =====================================================
# CLARA Admin & Observability (clara-admin-observability) — feature flags
# =====================================================
# Every flag below is ADDITIVE and defaults to the value that PRESERVES the
# pre-feature baseline (Requirements 12.1, 12.2). With all ADMIN_* flags off the
# admin/observability surface is byte-for-byte equivalent to the prior behavior;
# each capability ships dark and can be enabled independently per environment
# and rolled back instantly by setting the flag back to false (Requirement 12.4).

# Gate the live knowledge-ingestion/eval control path in admin_rag.py. Off ⇒ the
# control path returns the feature-disabled (404) shape. Default off.
ADMIN_RAG_INGESTION_CONTROLS_ENABLED=false
# Expose per-route p50/p90/p99 latency percentiles alongside the existing
# average in the metrics surface. Off ⇒ average-only baseline. Default off.
ADMIN_OBSERVABILITY_PERCENTILES_ENABLED=false
# Mirror appended flow events to the durable flow_event_archive store (PII-free
# projection) and read analytics from it. Off ⇒ in-memory FlowEventStore only.
# Default off.
ADMIN_OBSERVABILITY_PERSISTENT_STORE_ENABLED=false
# Enable the alert engine (evaluate/reconcile/acknowledge + optional webhook
# delivery). Off ⇒ no alert state is produced or persisted. Default off.
ADMIN_OBSERVABILITY_ALERTING_ENABLED=false
# Destination for no-PII alert webhook delivery, posted only on a
# not-firing → firing transition. Empty ⇒ in-app only (no outbound delivery),
# even when alerting is enabled. Default empty.
ADMIN_OBSERVABILITY_ALERT_WEBHOOK_URL=
# Enable the append-only admin-action audit trail (insert-only, opaque actor
# ref, PII-free meta). Off ⇒ no audit records are written. Default off.
ADMIN_AUDIT_LOG_ENABLED=false

# --- Distributed tracing / OpenTelemetry export (Requirement 6, ML service) ---
# Tracing switches read by services/ml. The tracer is a no-op unless
# OTEL_EXPORT_ENABLED=true AND OTEL_EXPORT_ENDPOINT is non-empty; export
# init/flush/export failures are swallowed so a request is always served
# (Requirements 6.2, 6.3, 6.5). Default off / unconfigured.
OTEL_EXPORT_ENABLED=false
OTEL_EXPORT_ENDPOINT=
OTEL_EXPORT_TIMEOUT_SECONDS=1.5
# Living Evidence monitor is dark until citation/material-change evaluation and
# clinical-safety approval are recorded. Subscriptions can still be saved.
LIFEMAP_EVIDENCE_MONITOR_ENABLED=false
# Ask My LifeMap remains read-only and exact-revision grounded. Enable the
# endpoint separately; semantic routing then uses the governed V4 Pro task only
# to choose a closed intent/block/escalation before retrieval. Set the second
# switch false for immediate deterministic keyword-route rollback.
LIFEMAP_ASK_AI_ENABLED=false
LIFEMAP_ASK_SEMANTIC_ROUTING_ENABLED=true
# Universal Capture stays dark unless its encrypted object store and malware
# scanner are configured. Text drafts can still be independently rolled back.
LIFEMAP_CAPTURE_ENABLED=false
LIFEMAP_CAPTURE_OBJECT_STORE_URL=
LIFEMAP_CAPTURE_ENCRYPTION_KEY=
LIFEMAP_CAPTURE_CLAMAV_HOST=
LIFEMAP_CAPTURE_CLAMAV_PORT=3310
LIFEMAP_CAPTURE_MAX_ARTIFACT_BYTES=10000000
# Optional DeepSeek V4 Flash extraction of exact, review-only spans from a
# LifeMap free-text note. The original note is retained as provenance and no
# candidate can become truth without an explicit user confirmation.
LIFEMAP_TEXT_DRAFT_EXTRACTION_ENABLED=false
# Strict FHIR R4 summary projection. This is not an IPS conformance claim.
LIFEMAP_FHIR_EXPORT_ENABLED=false
# Bounded FHIR R4 import into untrusted Universal Capture drafts only.
LIFEMAP_FHIR_IMPORT_ENABLED=false
# Vietnamese-first, provenance-bound LifeMap visit-preparation drafts. The
# endpoint is read-only and returns user-reviewable drafts only. Default off.
LIFEMAP_VIETNAMESE_DRAFTS_ENABLED=false
